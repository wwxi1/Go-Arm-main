<?xml version="1.0" encoding="utf-8"?>
<component_viewer schemaVersion="0.1" xmlns:xs="http://www.w3.org/2001/XMLSchema-instance" xs:noNamespaceSchemaLocation="Component_Viewer.xsd">
  <component name="ArmDiagnostics" version="1.0.0"/>
  <events>
    <group name="Arm debugging">
      <component name="Arm" brief="Arm events" no="0x30" prefix="Arm_"/>
    </group>
    <event id="0x3000" level="Op" property="Boot" value="state=%d[val1]"/>
    <event id="0x3001" level="Op" property="TrajectoryStart" value="state=%d[val1], duration_ms=%d[val2]"/>
    <event id="0x3002" level="Op" property="CommandsSent_ArrivalUnverified" value="state=%d[val1], result=%d[val2]"/>
    <event id="0x3003" level="Error" property="InvalidTarget" value="state=%d[val1], result=%d[val2]"/>
    <event id="0x3004" level="Op" property="Cancelled" value="state=%d[val1], result=%d[val2]"/>
    <event id="0x3005" level="Op" property="Superseded" value="state=%d[val1], result=%d[val2]"/>
    <event id="0x3006" level="Op" property="ResetRequested" value="state=%d[val1], result=%d[val2]"/>
    <event id="0x3007" level="Error" property="FeedbackTimeout_ALARM_ONLY" value="state=%d[val1], motor=%d[val2]"/>
    <event id="0x3008" level="Op" property="FeedbackRecovered" value="state=%d[val1], motor=%d[val2]"/>
    <event id="0x3009" level="Error" property="DriveError" value="state=%d[val1], motor_and_error=%x[val2]"/>
    <event id="0x300A" level="Op" property="Enabled" value="state=%d[val1]"/>
    <event id="0x300B" level="Op" property="Disabled" value="state=%d[val1]"/>
    <event id="0x300C" level="Op" property="ManualSnapshot" value="state=%d[val1]"/>
  </events>
</component_viewer>
